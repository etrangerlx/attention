# Compile command to build the project using CMake and Make
compile_command: mkdir -p build && cd build && cmake .. && make -j$(nproc)
# Command to run when "Run" button clicked
run_command: cd build && ./examples/basic_usage
# Command to install or update dependencies, will execute each time a new thread created to ensure dependencies up-to-date
dependency_command: sudo apt-get update && sudo apt-get install -y nvidia-cuda-toolkit nvidia-cuda-dev opencl-headers ocl-icd-opencl-dev libgtest-dev libbenchmark-dev libeigen3-dev pkg-config cmake build-essential